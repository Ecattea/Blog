---
import "@/styles/editorial-media.css";
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
import { DISPLAY_FONT_NAMES } from "@/config/fonts";
import { SOCIALS } from "@/constants";
import aboutWorkspaceImage from "@/assets/images/about-workspace.jpg";
---

<Layout title={`About | ${SITE.title}`} description={SITE.desc}>
  <section id="about">
    <div class="about-layout">
      <div class="profile-sticky">
        <h1 class="profile-name font-display">{SITE.author}.</h1>
        <div class="profile-role font-ui">
          Builder &amp; minimalist <br />writing in public
        </div>

        <div class="profile-links">
          {
            SOCIALS.map(({ name, href }) => (
              <a
                class="social-link font-ui"
                href={href}
                target="_blank"
                rel="noreferrer"
              >
                {name} <span aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="about-content">
        <p class="font-body">
          I build digital products that focus on clarity and purpose. This site
          is my place to think aloud—about design engineering, software
          architecture, and the craft of writing.
        </p>

        <figure class="editorial-media editorial-media--annotated">
          <div class="editorial-media-frame tilt-card image-card-wrapper">
            <div class="tilt-glare" aria-hidden="true"></div>
            <Image
              src={aboutWorkspaceImage}
              alt="Minimal workspace"
              class="editorial-media-image image-awakening"
              width={1000}
              height={667}
              quality="max"
              format={aboutWorkspaceImage.format}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="editorial-media-caption font-ui">
            Fig 1. A calm place to work.
          </figcaption>
        </figure>

        <p class="font-body">
          Currently, I&apos;m exploring the idea of calm technology—software
          that informs but doesn&apos;t demand attention.
        </p>

        <footer class="about-meta font-ui" aria-label="Build metadata">
          <dl class="about-meta-list">
            <div class="about-meta-row">
              <dt>Built with</dt>
              <dd>Astro</dd>
            </div>
            <div class="about-meta-row">
              <dt>Type set in</dt>
              <dd>{DISPLAY_FONT_NAMES.join(" & ")}</dd>
            </div>
          </dl>
        </footer>
      </div>
    </div>
  </section>
</Layout>
