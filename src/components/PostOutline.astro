---
import PostOutlineNav from "@/components/PostOutlineNav.astro";
import type { PostOutlineItem } from "@/utils/postOutline";

type Props = {
  outline: PostOutlineItem[];
  variant: "desktop" | "mobile";
};

const { outline, variant } = Astro.props;
const isMobile = variant === "mobile";
const outlineTitle = "On this page";
const outlineLabel = "Article outline";
---

{
  isMobile ? (
    <details
      class="post-outline-mobile font-ui"
      data-pagefind-ignore
      data-post-outline="mobile"
    >
      <summary class="post-outline-summary">{outlineTitle}</summary>
      <PostOutlineNav outline={outline} />
    </details>
  ) : (
    <aside
      class="post-outline-desktop font-ui"
      data-pagefind-ignore
      data-post-outline="desktop"
      aria-label={outlineLabel}
    >
      <div class="post-outline-card">
        <div class="post-outline-eyebrow">{outlineTitle}</div>
        <div class="post-outline-scroll">
          <PostOutlineNav outline={outline} />
        </div>
      </div>
    </aside>
  )
}
