---
import { type CollectionEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getPath } from "@/utils/getPath";
import { getPublishedPosts } from "@/services/posts";
import { SITE } from "@/config";
import { formatDisplayDate } from "@/utils/formatDate";
import { slugifyStr } from "@/utils/slugify";

type Props = {
  post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map(post => ({
    params: { slug: getPath(post.id, post.filePath, false) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
} = post.data;

let ogImageUrl: string | undefined;
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  ogImage: ogImageUrl,
  scrollSmooth: true,
};

const publishedLabel = formatDisplayDate(pubDatetime);
const publishedDateTime = pubDatetime.toISOString();
const hasUpdatedDate =
  modDatetime instanceof Date && modDatetime.getTime() !== pubDatetime.getTime();
const updatedLabel =
  hasUpdatedDate && modDatetime ? formatDisplayDate(modDatetime) : undefined;
const updatedDateTime =
  hasUpdatedDate && modDatetime ? modDatetime.toISOString() : undefined;
---

<Layout {...layoutProps}>
  <section id="post">
    <div class="post-container" data-pagefind-body>
      <header class="post-header">
        <h1 class="post-title font-display">
          {title}
        </h1>
        <div class="post-meta-panel font-ui" data-pagefind-ignore>
          <div class="post-meta-row">
            <a class="post-return-link" href="/articles/">
              Archive
            </a>
            <div class="post-facts" aria-label="Article metadata">
              <span class="post-fact">
                <span class="post-fact-label">Published</span>
                <time datetime={publishedDateTime}>{publishedLabel}</time>
              </span>
              {
                updatedLabel && updatedDateTime && (
                  <span class="post-fact">
                    <span class="post-fact-label">Updated</span>
                    <time datetime={updatedDateTime}>{updatedLabel}</time>
                  </span>
                )
              }
            </div>
          </div>
          {
            post.data.tags.length > 0 && (
              <div class="post-tag-list" aria-label="Article tags">
                {post.data.tags.map(tag => (
                  <a class="post-tag-chip" href={`/tags/${slugifyStr(tag)}/`}>
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <article class="post-content font-body">
        <Content />
      </article>
    </div>
  </section>
</Layout>
