---
import { type CollectionEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostOutline from "@/components/PostOutline.astro";
import { getPath } from "@/utils/getPath";
import { getPublishedPosts } from "@/services/posts";
import { SITE } from "@/config";
import { formatDisplayDate } from "@/utils/formatDate";
import {
  getPostOutline,
  shouldShowPostOutline,
} from "@/utils/postOutline";
import { slugifyStr } from "@/utils/slugify";

type Props = {
  post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map(post => ({
    params: { slug: getPath(post.id, post.filePath, false) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const {
  title,
  author,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
} = post.data;

let ogImageUrl: string | undefined;
if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

if (!ogImageUrl && SITE.dynamicOgImage) {
  ogImageUrl = `${getPath(post.id, post.filePath)}/index.png`;
}

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  ogImage: ogImageUrl,
  scrollSmooth: true,
};

const publishedLabel = formatDisplayDate(pubDatetime);
const updatedDate =
  modDatetime instanceof Date && modDatetime.getTime() !== pubDatetime.getTime()
    ? modDatetime
    : undefined;
const articleFacts = [
  {
    label: "Published",
    dateTime: pubDatetime.toISOString(),
    value: publishedLabel,
  },
  ...(updatedDate
    ? [
        {
          label: "Updated",
          dateTime: updatedDate.toISOString(),
          value: formatDisplayDate(updatedDate),
        },
      ]
    : []),
];
const tagLinks = post.data.tags.map(tag => ({
  label: tag,
  href: `/tags/${slugifyStr(tag)}/`,
}));
const outline = getPostOutline(headings);
const showOutline = shouldShowPostOutline(outline);
---

<Layout {...layoutProps}>
  <section id="post">
    <div class:list={["post-shell", showOutline && "post-shell-with-outline"]}>
      <div class="post-main" data-pagefind-body>
        <header class="post-header">
          <h1 class="post-title font-display">
            {title}
          </h1>
          <div class="post-meta-panel font-ui" data-pagefind-ignore>
            <div class="post-meta-row">
              <a class="post-return-link" href="/articles/">
                Archive
              </a>
              <dl class="post-facts" aria-label="Article metadata">
                {articleFacts.map(({ label, dateTime, value }) => (
                  <div class="post-fact">
                    <dt class="post-fact-label">{label}</dt>
                    <dd class="post-fact-value">
                      <time datetime={dateTime}>{value}</time>
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
            {
              tagLinks.length > 0 && (
                <div class="post-tag-list" aria-label="Article tags">
                  {tagLinks.map(({ label, href }) => (
                    <a class="post-tag-chip" href={href}>
                      {label}
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </header>

        {showOutline && <PostOutline outline={outline} variant="mobile" />}

        <article class="post-content font-body">
          <Content />
        </article>
      </div>

      {showOutline && <PostOutline outline={outline} variant="desktop" />}
    </div>
  </section>
</Layout>
