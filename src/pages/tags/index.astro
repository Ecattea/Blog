---
import Layout from "@/layouts/Layout.astro";
import { getTagSummaries } from "@/domain/posts";
import { SITE } from "@/config";

const tags = await getTagSummaries();
---

<Layout title={`Tags | ${SITE.title}`}>
  <section id="articles">
    <div class="archive-container">
      <div class="archive-header font-ui">Tags</div>
      <div class="tag-list font-ui">
        {
          tags.map(({ tag, tagName }) => (
            <a class="tag-link" href={`/tags/${tag}/`}>
              {tagName}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
