---
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <section id="articles">
    <div class="archive-container">
      <div class="archive-header font-ui">404</div>
      <h1 class="tag-title font-display">Page Not Found</h1>
      <p class="route-note route-note-symbol font-body">¯\_(ツ)_/¯</p>
      <nav
        class="archive-subnav archive-subnav-spaced font-ui"
        aria-label="Fallback navigation"
      >
        <a href="/">Home</a>
        <a href="/articles/">Articles</a>
      </nav>
    </div>
  </section>
</Layout>
