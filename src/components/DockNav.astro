---
const rawPathname = Astro.url.pathname;
const pathname = rawPathname.replace(/\/+$/, "") || "/";
const { class: className, ...rootProps } = Astro.props;

const isHome = pathname === "/";
const isAbout = pathname === "/about";
const isArticles =
  pathname.startsWith("/articles") ||
  pathname.startsWith("/tags") ||
  pathname.startsWith("/search") ||
  pathname.startsWith("/archives");
---

<div class:list={["dock-wrapper", className]} {...rootProps}>
  <nav class="dock tilt-dock" aria-label="Primary">
    <div class="tilt-glare" aria-hidden="true"></div>
    <a class:list={["dock-link", "font-ui", { active: isHome }]} href="/">
      Home
    </a>
    <a
      class:list={["dock-link", "font-ui", { active: isArticles }]}
      href="/articles/"
    >
      Articles
    </a>
    <a
      class:list={["dock-link", "font-ui", { active: isAbout }]}
      href="/about/"
    >
      About
    </a>
  </nav>
</div>
