---
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Pagination from "@/components/Pagination.astro";
import {
  getPublishedPosts,
  getPostsByTagFromPosts,
  getTagSummariesFromPosts,
} from "@/services/posts";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedPosts();
  const tags = getTagSummariesFromPosts(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTagFromPosts(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const { page, tagName } = Astro.props;
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`}>
  <section id="articles">
    <div class="archive-container">
      <div class="archive-header font-ui">Tag</div>
      <h1 class="tag-title font-display">{tagName}</h1>
      <div class="archive-subnav font-ui" aria-label="Secondary">
        <a href="/articles/">All Articles</a>
        <a href="/tags/">All Tags</a>
      </div>

      {page.data.map(post => <ArticleCard post={post} />)}

      <Pagination {page} />
    </div>
  </section>
</Layout>
