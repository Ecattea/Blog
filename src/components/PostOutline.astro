---
import type { PostOutlineItem } from "@/utils/postOutline";

type Props = {
  outline: PostOutlineItem[];
  variant: "desktop" | "mobile";
};

const { outline, variant } = Astro.props;
const isMobile = variant === "mobile";
---

{
  isMobile ? (
    <details
      class="post-outline-mobile font-ui"
      data-pagefind-ignore
      data-post-outline="mobile"
    >
      <summary class="post-outline-summary">On this page</summary>
      <nav class="post-outline-nav" aria-label="Article outline">
        <ol class="post-outline-list">
          {outline.map(({ depth, slug, text }) => (
            <li class:list={["post-outline-item", depth === 3 && "is-subitem"]}>
              <a href={`#${slug}`} data-outline-target={slug}>
                {text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  ) : (
    <aside
      class="post-outline-desktop font-ui"
      data-pagefind-ignore
      data-post-outline="desktop"
      aria-label="Article outline"
    >
      <div class="post-outline-sticky">
        <div class="post-outline-eyebrow">On this page</div>
        <nav class="post-outline-nav" aria-label="Article outline">
          <ol class="post-outline-list">
            {outline.map(({ depth, slug, text }) => (
              <li class:list={["post-outline-item", depth === 3 && "is-subitem"]}>
                <a href={`#${slug}`} data-outline-target={slug}>
                  {text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </aside>
  )
}
