---
import Layout from "@/layouts/Layout.astro";
import { getPublishedPosts } from "@/services/posts";
import { SITE } from "@/config";
import { formatDisplayDate } from "@/utils/formatDate";
import { getPath } from "@/utils/getPath";

const sortedPosts = await getPublishedPosts();
const latestPost = sortedPosts[0];

const latestHref = latestPost
  ? getPath(latestPost.id, latestPost.filePath)
  : "/articles/";
const latestDateLabel = latestPost
  ? formatDisplayDate(latestPost.data.modDatetime ?? latestPost.data.pubDatetime)
  : "";
---

<Layout title={SITE.title} description={SITE.desc}>
  <section id="home">
    <div class="container-wide">
      <div class="hero-header">
        <h1 class="hero-title font-display">
          {SITE.author}
          <br />
          <span style="font-style: italic; font-weight: 400; opacity: 0.85;"
            >{SITE.title.replace(`${SITE.author}'s `, "")}</span
          >
        </h1>
        <div class="hero-subtitle font-body">{SITE.desc}</div>
      </div>

      <a class="hero-card tilt-card" href={latestHref}>
        <div class="tilt-glare" aria-hidden="true"></div>
        <div class="tilt-content">
          <span class="hero-card-label font-ui">
            {latestPost ? `Latest Entry — ${latestDateLabel}` : "Latest Entry"}
          </span>
          <h3 class="hero-card-title font-display">
            {latestPost ? `"${latestPost.data.title}"` : "No posts yet."}
          </h3>
          <div class="hero-card-cta font-ui">
            Read Article <span aria-hidden="true">→</span>
          </div>
        </div>
      </a>
    </div>
  </section>
</Layout>
