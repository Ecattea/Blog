---
import type { CollectionEntry } from "astro:content";
import { formatDisplayDate } from "@/utils/formatDate";
import { getPath } from "@/utils/getPath";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const href = getPath(post.id, post.filePath);

const tagLabel = (post.data.tags?.[0] ?? "Article")
  .replace(/[-_]/g, " ")
  .replace(/\b\w/g, c => c.toUpperCase());

const displayDate = post.data.modDatetime ?? post.data.pubDatetime;
const dateLabel = formatDisplayDate(displayDate);
const dateTime = displayDate.toISOString();
---

<a class="article-card tilt-card" href={href}>
  <div class="tilt-glare" aria-hidden="true"></div>
  <div class="tilt-content">
    <div class="article-meta font-ui">
      <span>{tagLabel}</span>
      <time datetime={dateTime}>{dateLabel}</time>
    </div>
    <h2 class="article-title font-heading">
      {post.data.title}
      <span class="icon-arrow" aria-hidden="true">↗</span>
    </h2>
    <p class="article-excerpt font-body">{post.data.description}</p>
  </div>
</a>
