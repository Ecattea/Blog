---
import "@pagefind/default-ui/css/ui.css";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";
---

<Layout title={`Search | ${SITE.title}`}>
  <section id="articles">
    <div class="archive-container">
      <header class="page-header">
        <h1 class="tag-title font-display">Search</h1>
      </header>
      <div id="pagefind-search" transition:persist></div>
    </div>
  </section>
</Layout>

<script>
  function initSearch() {
    const pageFindSearch: HTMLElement | null =
      document.querySelector("#pagefind-search");

    if (!pageFindSearch) return;
    const searchRoot = pageFindSearch;

    const params = new URLSearchParams(window.location.search);
    const getCurrentTerm = () =>
      (
        document.querySelector<HTMLInputElement>(".pagefind-ui__search-input")
          ?.value ??
        params.get("q") ??
        ""
      ).trim();

    const parseTerms = (value: string) => [
      ...new Set(value.split(/\s+/g).filter(Boolean)),
    ];

    const escapeRegExp = (value: string) =>
      value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

    const stripMarkTags = (value: string) =>
      value.replace(/<mark\b[^>]*>/gi, "").replace(/<\/mark>/gi, "");

    const buildMatcher = (value: string) => {
      const terms = parseTerms(value);
      if (terms.length === 0) return null;
      return new RegExp(`(${terms.map(escapeRegExp).join("|")})`, "gi");
    };

    function highlightTextNodes(root: HTMLElement, matcher: RegExp | null) {
      if (!matcher) return;

      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      const textNodes: Text[] = [];
      let current = walker.nextNode();

      while (current) {
        if (current instanceof Text) {
          const text = current.nodeValue ?? "";
          if (text.trim().length > 0) {
            textNodes.push(current);
          }
        }
        current = walker.nextNode();
      }

      textNodes.forEach(node => {
        const text = node.nodeValue ?? "";
        matcher.lastIndex = 0;
        if (!matcher.test(text)) return;
        matcher.lastIndex = 0;

        const fragment = document.createDocumentFragment();
        let lastIndex = 0;

        text.replace(matcher, (match, _group, offset) => {
          const start = Number(offset);

          if (start > lastIndex) {
            fragment.append(
              document.createTextNode(text.slice(lastIndex, start))
            );
          }

          const mark = document.createElement("mark");
          mark.textContent = match;
          fragment.append(mark);
          lastIndex = start + match.length;

          return match;
        });

        if (lastIndex < text.length) {
          fragment.append(document.createTextNode(text.slice(lastIndex)));
        }

        node.parentNode?.replaceChild(fragment, node);
      });
    }

    function applyCustomHighlights(rawTerm: string) {
      const matcher = buildMatcher(rawTerm);

      const links = searchRoot.querySelectorAll<HTMLAnchorElement>(
        ".pagefind-ui__result-title .pagefind-ui__result-link"
      );

      links.forEach(link => {
        if (!link.dataset.pagefindRawText) {
          link.dataset.pagefindRawText = link.textContent ?? "";
        }

        link.textContent = link.dataset.pagefindRawText;
        highlightTextNodes(link, matcher);
      });

      const excerpts = searchRoot.querySelectorAll<HTMLElement>(
        ".pagefind-ui__result-excerpt"
      );

      excerpts.forEach(excerpt => {
        if (!excerpt.dataset.pagefindRawHtml) {
          excerpt.dataset.pagefindRawHtml = stripMarkTags(excerpt.innerHTML);
        }

        excerpt.innerHTML = excerpt.dataset.pagefindRawHtml;
        highlightTextNodes(excerpt, matcher);
      });
    }

    let pendingHighlight = false;
    let nextTerm = "";
    const scheduleHighlight = (rawTerm: string) => {
      nextTerm = rawTerm;
      if (pendingHighlight) return;

      pendingHighlight = true;
      window.requestAnimationFrame(() => {
        pendingHighlight = false;
        applyCustomHighlights(nextTerm);
      });
    };

    if (searchRoot.dataset.searchHighlightBound !== "1") {
      searchRoot.dataset.searchHighlightBound = "1";

      const observer = new MutationObserver(() => {
        scheduleHighlight(getCurrentTerm());
      });

      observer.observe(searchRoot, {
        childList: true,
        subtree: true,
      });

      document.addEventListener("input", event => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;
        if (!target.classList.contains("pagefind-ui__search-input")) return;
        scheduleHighlight(target.value);
      });
    }

    const onIdle = window.requestIdleCallback || (cb => setTimeout(cb, 1));

    onIdle(async () => {
      if (import.meta.env.DEV) {
        pageFindSearch.innerHTML = `
            <div class="search-dev-note">
              <p class="search-dev-note-copy font-ui"><strong>DEV mode:</strong> Pagefind index is generated during build. Use preview to test search.</p>
              <code class="search-dev-note-command">pnpm run build</code>
              <code class="search-dev-note-command">pnpm run preview</code>
            </div>
          `;
        return;
      }

      // @ts-expect-error — Missing types for @pagefind/default-ui package.
      const { PagefindUI } = await import("@pagefind/default-ui");

      // Init pagefind ui
      const search = new PagefindUI({
        element: "#pagefind-search",
        showImages: false,
        showSubResults: true,
        processTerm: function (term: string) {
          params.set("q", term); // Update the `q` parameter in the URL
          history.replaceState(history.state, "", "?" + params.toString()); // Push the new URL without reloading

          scheduleHighlight(term);
          return term;
        },
      });

      // If search param exists (eg: search?q=astro), trigger search
      const query = params.get("q");
      if (query) {
        search.triggerSearch(query);
        scheduleHighlight(query);
      }

      // Reset search param if search input is cleared
      const searchInput = document.querySelector(".pagefind-ui__search-input");
      const clearButton = document.querySelector(".pagefind-ui__search-clear");
      searchInput?.addEventListener("input", resetSearchParam);
      clearButton?.addEventListener("click", resetSearchParam);

      function resetSearchParam(e: Event) {
        if ((e.target as HTMLInputElement)?.value.trim() === "") {
          history.replaceState(history.state, "", window.location.pathname);
        }
      }
    });
  }

  document.addEventListener("astro:after-swap", () => {
    const pagefindSearch = document.querySelector("#pagefind-search");

    // if pagefind search form already exists, don't initialize search component
    if (pagefindSearch && pagefindSearch.querySelector("form")) return;

    initSearch();
  });
  initSearch();
</script>

<style is:global>
  #pagefind-search {
    --pagefind-ui-font: "Inter", sans-serif;
    --pagefind-ui-text: var(--text-primary);
    --pagefind-ui-background: var(--bg-canvas);
    --pagefind-ui-border: var(--border-subtle);
    --pagefind-ui-primary: var(--accent-color);
    --pagefind-ui-tag: var(--bg-canvas);
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;

    form::before {
      background-color: var(--text-primary);
    }

    input {
      font-weight: 400;
      border: 1px solid var(--border-subtle);
      background: var(--bg-card);
      backdrop-filter: blur(12px);
    }

    input:focus-visible {
      outline: 2px dashed var(--accent-color);
      outline-offset: 3px;
    }

    .pagefind-ui__result-title a {
      color: var(--text-primary);
      outline-offset: 3px;
      outline-color: var(--accent-color);
      text-decoration-style: dashed;
      text-underline-offset: 4px;
    }

    .pagefind-ui__result-title a:focus-visible,
    .pagefind-ui__search-clear:focus-visible {
      text-decoration-line: none;
      outline-width: 2px;
      outline-style: dashed;
    }

    mark {
      background: color-mix(
        in srgb,
        var(--accent-color) 18%,
        var(--color-bg-canvas) 82%
      );
      color: color-mix(
        in srgb,
        var(--text-primary) 88%,
        var(--accent-color) 12%
      );
      border-radius: 0.2em;
      padding: 0 0.12em;
    }

    .search-dev-note {
      margin-bottom: 1.5rem;
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      background: var(--bg-card);
      padding: 1rem 1.25rem;
    }

    .search-dev-note-copy {
      color: var(--text-secondary);
    }

    .search-dev-note-command {
      display: block;
      margin-top: 0.75rem;
    }

    .search-dev-note-command + .search-dev-note-command {
      margin-top: 0.5rem;
    }

    .pagefind-ui__result:last-of-type {
      border-bottom: 0;
    }

    .pagefind-ui__result-nested .pagefind-ui__result-link:before {
      font-family: system-ui;
    }
  }
</style>
