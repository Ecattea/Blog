---
import Layout from "@/layouts/Layout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import { getArchiveGroups } from "@/services/posts";
import { SITE } from "@/config";

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const archiveGroups = await getArchiveGroups({
  sortBy: "pubDatetime",
  timezone: SITE.timezone,
});
---

<Layout title={`Archives | ${SITE.title}`}>
  <section id="articles">
    <div class="archive-container">
      <header class="page-header">
        <h1 class="tag-title font-display">Archives</h1>
      </header>
      {
        archiveGroups.map(({ year, postCount, months }) => (
          <div class="archive-year">
            <div class="archive-year-title font-display">
              {year} <sup class="archive-count font-ui">{postCount}</sup>
            </div>
            {months.map(monthGroup => (
              <div class="archive-month">
                <div class="archive-month-title font-ui">
                  {monthGroup.monthLabel}{" "}
                  <sup class="archive-count">{monthGroup.posts.length}</sup>
                </div>
                {monthGroup.posts.map(post => (
                  <ArticleCard post={post} />
                ))}
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</Layout>
